#pragma once
// Private settings -- copy to secrets.h (never committed) and fill in.
// Everything here is optional: without this file the firmware builds and runs,
// just without the photo upload. Setting up the service: see cloud/README.md.

// Wi-Fi networks to try, in order (party Wi-Fi, home, phone hotspot...).
#define WIFI_NETWORKS {{"party-wifi", "password"}, {"home-wifi", "password"}}

// Your photo service (cloud/deploy.sh prints both): its base URL, no trailing
// slash, and UPLOAD_KEY from cloud/.keys.
#define PHOTO_SERVICE_URL "https://your-service-xxxxxxxxxx.us-central1.run.app"
#define PHOTO_UPLOAD_KEY "paste UPLOAD_KEY here"

// Where guests see their photos: shown on screen (short, capitals).
#define PHOTO_SITE_TEXT "YOURSITE.COM/HALLOWEEN"

// The costume's QR code (scene QR and the "on the wall" notice): your landing page.
#define QR_URL "https://yoursite.com/halloween/"
